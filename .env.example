# ============================================================
# Пример конфигурации окружения. Скопируйте в .env и заполните.
#   cp .env.example .env
# Файл .env в git НЕ попадает и не должен попадать.
# ============================================================

# --- Режим запуска (используется start.sh внутри контейнера) ---
# dev  -> uvicorn с автоперезагрузкой
# prod -> gunicorn (значение по умолчанию)
ENVIRONMENT=prod

# --- Гибридный LLM: основной провайдер (DeepSeek) ---
# Используется для анализа больших текстов (экономит токены).
BASE_URL=https://api.deepseek.com/v1
API_KEY=

# --- Гибридный LLM: альтернативный провайдер (GPT-4o) ---
# Используется для быстрых JSON-запросов (шаги анализа, финализация).
# Если переменные не заданы — альтернативный клиент не создаётся и
# вся работа идёт через основного провайдера.
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_API_KEY=

# --- Redis (кэш, параметры W/Price, история изменений) ---
# REDIS_PASSWORD — пароль доступа к Redis. В production обязателен:
# прошлый сервер был заблокирован хостером именно из-за Redis без пароля,
# опубликованного на 6379 наружу. Сгенерируйте, например:
#   openssl rand -base64 24
# В dev можно оставить пустым — тогда Redis работает без пароля, а доступ
# к нему всё равно остаётся только внутри docker-сети.
REDIS_PASSWORD=

# REDIS_URL обычно менять не нужно: docker-compose.yml собирает его сам из
# REDIS_PASSWORD. Указывайте здесь только для запуска вне docker.
# Для запуска вне docker: redis://localhost:6379
# При включённом пароле: redis://:ВАШ_ПАРОЛЬ@localhost:6379/0
REDIS_URL=redis://redis:6379

# --- Доступ к админ-панели ---
# Bearer-токен, который требует весь блок /admin (лиды с персональными
# данными, смена цены и реквизитов ЮKassa). В production обязателен:
# без него API отвечает 503 и не отдаёт ничего. Сгенерируйте:
#   openssl rand -base64 32
# В dev можно оставить пустым — локально панель открывается без токена.
ADMIN_TOKEN=

# --- База данных клиентских сеансов (SQLite) ---
# Путь относительно рабочей директории контейнера (/app).
DB_PATH=sessions.db

# --- Параметры услуги (изначальные значения для Redis) ---
# W     — длительность сеанса в минутах (1440 = 24 часа)
# Price — цена услуги в рублях, целое число без копеек
# В дальнейшем правятся через админ-панель и хранятся в Redis;
# здесь задаются только значения для первой инициализации.
W=1440
Price=1000

# --- ЮKassa ---
# Могут задаваться здесь или через админ-панель (Redis имеет приоритет).
ShopID=
Ykassa_API=

# --- Адрес фронтенда для возврата после оплаты ---
# На него ЮKassa редиректит клиента с ?payment_success=true
FRONTEND_URL=http://localhost:3000

# --- CORS (только если фронт и API на РАЗНЫХ доменах) ---
# По умолчанию фронт ходит к API через reverse-proxy nginx того же контейнера
# (same-origin), поэтому CORS не задействуется и переменную можно не задавать.
# Если API вынесен на отдельный домен — перечислите origin-ы фронта через
# запятую. Wildcard "*" не поддерживается.
# Пример: CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# --- Базовый адрес API для фронтенда (только при выносе API на другой домен) ---
# VITE_API_URL подставляется в код фронта при сборке (docker build arg).
# Если не задан — фронт использует относительные пути и nginx-прокси контейнера.
# Пример для разнесённых доменов: VITE_API_URL=https://api.example.com
VITE_API_URL=

# --- Домены для Caddy (только production) ---
# Caddy получает TLS-сертификаты Let's Encrypt и раздаёт:
#   SITE_DOMAIN  -> клиентский сайт (контейнер frontend)
#   ADMIN_DOMAIN -> админ-панель (контейнер admin-frontend)
# Админка обязана быть на отдельном поддомене: Vite собирает её с base="/",
# поэтому на пути вида /admin/ она не находит собственные JS.
# Обе DNS-A записи должны указывать на IP сервера до запуска, иначе Caddy не
# сможет пройти проверку ACME и не поднимется.
SITE_DOMAIN=
ADMIN_DOMAIN=

# Почта для Let's Encrypt: на неё приходят предупреждения об истечении
# сертификата. Без неё сертификат всё равно выпустится, но анонимно.
ACME_EMAIL=

# --- Имена контейнеров при деплое (использует docker-compose.yml) ---
# Заполняются GitHub Actions; локально можно оставить пустыми.
UNIQUE_TAG=
DEPLOY_ID=
